<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.litellm.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec HOME/.local/bin/litellm --config HOME/.config/litellm/config.yaml --port PORT 2>&1 | while IFS= read -r line; do echo "$(date '+%Y-%m-%d %H:%M:%S') $line"; done</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>NetworkState</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>HOME/.local/state/litellm/service.log</string>
    <key>StandardErrorPath</key>
    <string>HOME/.local/state/litellm/service.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LITELLM_LOG</key>
        <string>DEBUG</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:HOME/.local/bin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>HOME</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
